# ---- Discord ----
# From https://discord.com/developers/applications -> your app -> "Bot" tab
DISCORD_TOKEN=paste_your_bot_token_here
# From the "General Information" tab of your application
DISCORD_CLIENT_ID=paste_your_application_client_id_here
# Optional: your OWN server's ID. If set, slash commands deploy instantly to
# this server only (great for testing). Leave blank to deploy globally
# (takes up to 1 hour to show up everywhere, but works in every server the
# bot is invited to - what you want once you're selling kits).
HOME_GUILD_ID=

# ---- Stripe ----
# From https://dashboard.stripe.com/apikeys - use a TEST key while building,
# swap to a LIVE key (starts with sk_live_) only when you're ready to sell.
STRIPE_SECRET_KEY=paste_your_stripe_secret_key_here
# The Price ID (starts with price_...) of the $29 Gaming Kit product you
# create in the Stripe Dashboard. This is how /activate knows which kit a
# payment was for.
STRIPE_PRICE_GAMING=paste_the_gaming_kit_price_id_here

# ---- Bot invite link ----
# The OAuth2 "Add to server" URL for YOUR bot, with the "bot" +
# "applications.commands" scopes and Administrator permission. Generate it
# from the Developer Portal -> your app -> OAuth2 -> URL Generator.
# Shown to customers on the post-purchase success page.
BOT_INVITE_URL=paste_your_bot_invite_url_here

# ---- Web server (for the post-purchase "activate" instructions page) ----
# Railway/Render set this automatically - only set it yourself for local testing.
PORT=3000
# The public URL your app is hosted at, e.g. https://kitbot-production.up.railway.app
PUBLIC_URL=http://localhost:3000
